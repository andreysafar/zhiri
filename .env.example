# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use (default: Gemini Flash 1.5)
OPENROUTER_MODEL=google/gemini-flash-1.5

# How many messages to keep in context per user (default: 20)
MAX_CONTEXT_MESSAGES=20

# Optional: Duma API token for scraping speeches (NOT required for the bot to run)
# Register free at https://api.duma.gov.ru/ if you want to bulk-download speeches
# DUMA_API_TOKEN=your_optional_duma_token
